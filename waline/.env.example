# Vercel-side MongoDB configuration. Set these in the Waline Vercel project.
MONGO_HOST=cluster0.example.mongodb.net
MONGO_PORT=27017
MONGO_DB=waline
MONGO_USER=waline
MONGO_PASSWORD=replace-with-atlas-password
MONGO_AUTHSOURCE=admin
MONGO_OPT_TLS=true

# Waline site and security configuration.
SITE_NAME=袅残烟的冥想盆
SITE_URL=https://blog.seekdoor.me
SECURE_DOMAINS=blog.seekdoor.me
JWT_TOKEN=replace-with-a-long-random-secret
AUTHOR_EMAIL=
LOGIN=enable
